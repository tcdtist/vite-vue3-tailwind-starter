{
  "name": "public-vite-vue3-tailwind-starter",
  "description": "Vite Vue 3 Tailwind Starter",
  "author": "tcdtist",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --port 8000",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "eslint src --ext .js,.vue --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.vue --fix",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "prepare": "husky install"
  },
  "dependencies": {
    "tailwind-merge": "^2.5.2",
    "use-debounce": "^10.0.3",
    "uuid": "^10.0.0",
    "vue": "^3.4.37",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^9.27.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "stylelint": "^16.8.1",
    "stylelint-config-recommended": "^14.0.1",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.1"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": "yarn lint:fix",
    "src/**/*.{js,vue,json,css,scss,md}": "yarn prettier:fix"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint-staged"
    }
  },
  "packageManager": "yarn@1.22.22"
}
